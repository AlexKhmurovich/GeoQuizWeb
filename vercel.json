{
   "version": 2,
   "builds": [
      {
         "src": "src/server/server.cjs",
         "use": "@vercel/node"
      },
      {
         "src": "package.json",
         "use": "@vercel/static-build",
         "config": { "distDir": "dist" }
      }
   ],
   "routes": [
      {
         "src": "/socket.io/(.*)",
         "dest": "src/server/server.cjs"
      },
      {
         "src": "/(.*)",
         "dest": "/"
      }
   ]
}
