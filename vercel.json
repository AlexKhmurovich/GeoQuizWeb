{
   "version": 2,
   "builds": [
      {
         "src": "api/**/*.js",
         "use": "@vercel/node"
      },
      {
         "src": "package.json",
         "use": "@vercel/static-build",
         "config": {
            "distDir": "dist"
         }
      }
   ],
   "routes": [
      {
         "src": "/socket.io/(.*)",
         "dest": "/api/index.js"
      },
      {
         "src": "/api/(.*)",
         "dest": "/api/$1"
      },
      {
         "src": "/assets/(.*)",
         "dest": "/assets/$1"
      },
      {
         "src": "/(.*\\.[a-z0-9]+$)",
         "dest": "/$1"
      },
      {
         "src": "/(.*)",
         "dest": "/index.html"
      }
   ]
}
